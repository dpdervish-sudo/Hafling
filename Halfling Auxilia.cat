            <characteristic name="W" typeId="216e778e-a6f9-53e0-86ae-399ccd2333c7">2</characteristic>
            <characteristic name="I" typeId="96eac4ff-a020-5797-b76d-118d30b45da2">4</characteristic>
            <characteristic name="A" typeId="da5ce416-0814-56f1-bffe-90d0e8264b80">1</characteristic>
            <characteristic name="Ld" typeId="bda7bfbc-019b-5f38-8ff0-63effc838e3b">6</characteristic>
          </characteristics>
        </profile>
        <profile id="4ffa7f0a-506a-5bfb-9afc-af6e1429212a" name="Hunting Longbow (perched)" hidden="false" typeId="66a5eec0-5ec5-52ee-9bf9-d19d7d735baf" typeName="Weapon">
          <characteristics>
            <characteristic name="R" typeId="1e547d7c-d536-58da-b3e4-95801380abb2">36&quot;</characteristic>
            <characteristic name="S" typeId="21ae8943-c4a1-5585-826d-53c15cdde4cf">4</characteristic>
            <characteristic name="AP" typeId="39f009b6-8000-5606-aee9-33d8adfa4cf5">1</characteristic>
            <characteristic name="Special Rules" typeId="6e94c262-fd81-588c-8250-d1d2df58803c">Armour Piercing (1), Multiple Shots (1)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9ff98a78-272a-5a7f-88a7-2d27cc532409" name="Perched High" hidden="false">
          <description>Ignores intervening units and terrain when drawing line of sight and may never be denied a target for cover reasons; counts as being on a hill at all times. May not be targeted separately while the Harvester is alive, and is removed with it. May shoot in a turn the Harvester moved with no penalty.</description>
        </rule>
        <rule id="8a699ef8-96d0-593f-b56b-e9bcf004212c" name="Hold On, Tiny!" hidden="false">
          <description>Whenever the Great Cannon fires, roll a D6 after resolving the shot. 1: Overboard - the Marksman is removed as a casualty immediately, with no saves of any kind permitted, and the crow's nest is wrecked and empty for the rest of the game; no other model may occupy it. 2+: Braced - no effect whatsoever. Once the Marksman has been lost, stop rolling.</description>
        </rule>
        <rule id="0ac6a2ea-a084-5973-af38-2211ffbc1ec4" name="Sniper" hidden="false">
          <description>May target enemy characters directly, unless the character is in a unit of 10 or more rank-and-file models.</description>
        </rule>
        <rule id="94afe7e3-13e6-5b42-a8ad-08e47ec08b74" name="Hard to See" hidden="false">
          <description>Enemy shooting attacks targeting the Marksman suffer an additional -1 To Hit, on top of Little Folk.</description>
        </rule>
        <rule id="d9521b53-46fb-56f6-9d92-8c6e57f10ccc" name="Little Folk" hidden="false">
          <description>See army special rules.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="9aacdbe8-141a-5fbf-a6ce-949b60b97333" name="Rare" hidden="false" targetId="50411563-e722-5892-bc98-ba49b8f83350" primary="true"/>
      </categoryLinks>
    </selectionEntry>
