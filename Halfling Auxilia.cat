      </constraints>
      <profiles>
        <profile id="57c1d109-70b6-59b8-863c-5018ae845253" name="Battle Harvester" hidden="false" typeId="6be2102c-91aa-54f9-aff0-8f6b92f6f9ae" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="bf96bcb3-be7d-5906-8588-3df6bab11836">7</characteristic>
