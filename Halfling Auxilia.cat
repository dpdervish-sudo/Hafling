        <profile id="5aa5a6fd-3d25-56a5-85f3-7e6c9053468c" name="Crow's Nest Marksman" hidden="false" typeId="6be2102c-91aa-54f9-aff0-8f6b92f6f9ae" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="bf96bcb3-be7d-5906-8588-3df6bab11836">4</characteristic>
            <characteristic name="WS" typeId="7cca2aac-4f6e-5db7-a2ab-ef4aa5c6366f">2</characteristic>
            <characteristic name="BS" typeId="ce9df1cd-97ab-506a-a2ce-e18d3c8cf504">6</characteristic>
