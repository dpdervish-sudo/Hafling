      <rules>
        <rule id="8a9e5558-437b-5e58-be42-adb79234f6e3" name="Follow the Basket" hidden="false">
          <description>While the Moot Elder is on the table and not fleeing, friendly Little Folk units within 12&quot; may use his Leadership, and may re-roll failed Break tests if also within 6&quot; of a friendly Battle Standard.</description>
        </rule>
        <rule id="175328e6-45d2-5ab6-b8ab-b65c4aad0c1e" name="Little Folk" hidden="false">
